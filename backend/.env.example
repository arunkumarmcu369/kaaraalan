# Local development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaaralan_goli_soda
SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
IDLE_SESSION_TIMEOUT_MINUTES=60
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin

# --- WhatsApp Cloud API (Meta) ---
# Leave WHATSAPP_ENABLED=false until Railway vars + templates are ready.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1173633149174419
WHATSAPP_WABA_ID=1531290778102440
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=kaaraalan_wa_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_ALLOW_TEXT_FALLBACK=true
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_ORDER_PLACED=order_received
WHATSAPP_TEMPLATE_ORDER_APPROVED=order_approved
WHATSAPP_TEMPLATE_ORDER_REJECTED=order_rejected
WHATSAPP_TEMPLATE_ORDER_DISPATCHED=order_dispatched

# --- Railway production (set in Railway Variables, not this file) ---
# DATABASE_URL          → auto-filled when you link Railway Postgres
# SECRET_KEY            → long random string
# COOKIE_SECURE=true
# COOKIE_DOMAIN=        → leave empty (host-only on api.kaaraalan.in) OR .kaaraalan.in
# FRONTEND_ORIGIN=https://kaaraalan.in
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=  → strong password (change after first login)
# WHATSAPP_ENABLED=true
# WHATSAPP_TOKEN=       → System User permanent token
# WHATSAPP_PHONE_NUMBER_ID=1173633149174419
# WHATSAPP_VERIFY_TOKEN=kaaraalan_wa_verify_2026
# WHATSAPP_ADMIN_PHONE=91XXXXXXXXXX   → optional admin alert number
